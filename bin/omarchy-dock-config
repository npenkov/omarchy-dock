#!/bin/bash
#
# Interactive configurator for the rdf.dock shell plugin.
#
# Everything it writes lands in the plugin's entry in shell.json, which the
# Omarchy shell re-reads on save — so every change here shows up on the dock
# immediately, with no restart. (Only edits to the plugin's own Dock.qml
# need `omarchy restart shell`; nothing here touches that.)
#
# Items can be drawn as full-colour app icons or as Nerd Font glyphs; the
# glyph picker under "Change icon / glyph" carries a curated list, and any
# glyph can be pasted. Tiles default to the shell's button styling so the
# dock matches the rest of the Quickshell kit.
#
# gum picks up its colors from the GUM_* variables the session exports from
# the current theme, so this follows `omarchy theme set` like the dock does.

set -uo pipefail

CFG="$HOME/.config/omarchy/shell.json"
DOCK='(.plugins[] | select(.id=="rdf.dock"))'
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

# ----------------------------------------------------------------- plumbing

die() {
  gum style --foreground 1 "$1" >&2
  exit 1
}

heading() { gum style --bold --foreground "${GUM_CHOOSE_HEADER_FOREGROUND:-4}" "$@"; }
notice() { gum style --faint "$@"; }

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."
}

# Write a mutated config atomically, but only if the result is still valid
# JSON that keeps the dock entry intact. A broken shell.json costs you the
# whole bar, not just the dock.
apply() {
  local expr=$1 tmp
  tmp=$(mktemp "$CFG.XXXXXX") || return 1

  if ! jq "$DOCK |= ($expr)" "$CFG" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    gum style --foreground 1 "Update failed — nothing changed."
    return 1
  fi

  if ! jq -e "$DOCK | .id" "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    gum style --foreground 1 "Update would have dropped the dock entry — nothing changed."
    return 1
  fi

  cp "$CFG" "$CFG.bak"
  mv "$tmp" "$CFG"
}

dock_field() { jq -r "$DOCK | $1" "$CFG" 2>/dev/null; }

item_count() { dock_field '.items | length'; }

item_label() {
  jq -r "$DOCK.items[$1] |
    if .spacer == true then \"── divider ──\"
    else (.label // .desktop // .exec // \"(unnamed)\") end" "$CFG"
}

# gum's --label-delimiter reads each line as "label<delim>value": it shows the
# label and hands back the value. So these lines carry the display text first
# and the item's position second, and a pick comes back as a bare index.
# An item drawn as a glyph shows that glyph in front of its name, so the list
# reads the way the dock does.
item_choices() {
  jq -r "$DOCK.items | to_entries[] |
    \"\(.key + 1). \" +
    (if .value.spacer == true then \"── divider ──\"
     else ((if .value.glyph then \"\(.value.glyph)  \" else \"\" end) +
           (.value.label // .value.desktop // .value.exec // \"(unnamed)\")) end) +
    \"\t\(.key + 1)\"" "$CFG"
}

show_items() {
  local count
  count=$(item_count)
  if [[ $count == "0" || -z $count ]]; then
    notice "The dock is empty."
    return
  fi
  heading "Dock contents"
  item_choices | cut -f1 | while read -r line; do
    printf '  %s\n' "$line"
  done
  echo
}

# --------------------------------------------------------------- app lookup

# The same set your launcher shows: every desktop entry, minus the ones
# Omarchy hides. Both hide lists come straight from the shell's own sources
# so this list can't drift from what the launcher displays.
list_apps() {
  local hidden
  hidden=$(
    bash "$OMARCHY_PATH/shell/services/hidden-entries.sh" "" 2>/dev/null
    cat "$HOME/.config/omarchy/launcher.hides" 2>/dev/null
    cat "$OMARCHY_PATH/default/omarchy/launcher.hides" 2>/dev/null
  )

  local dirs=("$HOME/.local/share/applications" /usr/share/applications)
  local dir file id name
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    for file in "$dir"/*.desktop; do
      [[ -e $file ]] || continue
      id=$(basename "$file" .desktop)

      grep -qiE '^(NoDisplay|Hidden)[[:space:]]*=[[:space:]]*true' "$file" && continue
      grep -qxF "$id" <<<"$hidden" && continue

      name=$(grep -m1 '^Name=' "$file" | cut -d= -f2-)
      printf '%s\t%s\n' "${name:-$id}" "$id"
    done
  done | sort -u -t$'\t' -k1,1
}

# ------------------------------------------------------------------ glyphs
#
# A glyph is a Nerd Font character standing in for an app icon. Drawn in the
# shell's text colour it makes the dock read like the rest of the Quickshell
# kit instead of a row of full-colour logos. Any item can carry one; it wins
# over `icon` and over the desktop entry's own artwork.

# name<TAB>codepoint. Codepoints are Nerd Fonts v3 (Material Design range),
# every one checked to render in JetBrainsMono Nerd Font.
glyph_table() {
  local e
  for e in \
    "browser (chrome)|F02AF" \
    "firefox|F0239" \
    "edge|F01E9" \
    "web|F059F" \
    "terminal (console)|F018D" \
    "terminal (prompt)|F07B7" \
    "terminal (octicon)|F489" \
    "files (folder)|F024B" \
    "folder open|F0770" \
    "document|F0219" \
    "file|F0214" \
    "vs code|F0A1E" \
    "git|F02A2" \
    "github|F02A4" \
    "docker|F0868" \
    "database|F01BC" \
    "package|F03D6" \
    "remote desktop|F08B9" \
    "windows|F05B3" \
    "linux|F033D" \
    "apple|F179" \
    "monitor|F0379" \
    "laptop|F0322" \
    "harddisk|F02CA" \
    "claude / ai (sparkles)|F0674" \
    "robot|F06A9" \
    "message|F0361" \
    "chat|F0B79" \
    "email|F01EE" \
    "calendar|F00ED" \
    "music|F0386" \
    "spotify|F04C7" \
    "youtube|F05C3" \
    "video|F0567" \
    "camera|F0104" \
    "image|F02E9" \
    "palette|F03D8" \
    "settings (cog)|F0493" \
    "apps (grid)|F003B" \
    "information|F02FC" \
    "play|F040A" \
    "refresh|F0453" \
    "lock|F033E" \
    "power|F0425" \
    "close / kill|F0156" \
    "volume|F057E" \
    "wifi|F05A9" \
    "bluetooth|F00AF" \
    "discord|F066F" \
    "ghost|F02A0" \
  ; do printf '%s\t%s\n' "${e%|*}" "${e##*|}"; done
}

# Turn a hex codepoint into the character itself.
glyph_char() { printf "\\U$(printf '%08X' "0x$1")"; }

# Prints the chosen glyph, or nothing if the user backed out. `gum filter`
# shows "<glyph>  <name>" and hands back the codepoint after the tab.
pick_glyph() {
  local header=${1:-"Pick a glyph"} line name cp picked
  picked=$(
    while IFS=$'\t' read -r name cp; do
      [[ -z $cp ]] && continue
      printf '%s  %s\t%s\n' "$(glyph_char "$cp")" "$name" "$cp"
    done < <(glyph_table) |
    gum filter --header "$header" --placeholder "Type to search" --label-delimiter=$'\t'
  ) || return
  # gum's label-delimiter returns just the value when the input has one; be
  # tolerant of either shape.
  cp=${picked##*$'\t'}
  [[ -z $cp ]] && return
  glyph_char "$cp"
}

# Choose how one item is drawn: a glyph from the list, a pasted glyph, an
# icon-theme name or file, or the app's own icon. Writes the item and returns
# 0 when something changed.
set_item_artwork() {
  local idx=$1 label kind art
  label=$(item_label "$idx")

  kind=$(gum choose \
    "Glyph from the list" \
    "Paste a glyph" \
    "Icon from your icon theme" \
    "Use the app's own icon" \
    --header "How should \"$label\" look?  (currently: $(dock_field ".items[$idx] | if .glyph then \"glyph \(.glyph)\" elif .icon then \"icon \(.icon)\" else \"app icon\" end"))")

  case $kind in
    "Glyph from the list")
      art=$(pick_glyph "Glyph for \"$label\"") || return 1
      [[ -z $art ]] && return 1
      apply ".items[$idx] |= (del(.icon, .iconScale) | .glyph = $(jq -Rn --arg g "$art" '$g'))" ;;
    "Paste a glyph")
      art=$(gum input --header "Paste a glyph (nerdfonts.com/cheat-sheet)" --placeholder "󰆍")
      [[ -z $art ]] && return 1
      apply ".items[$idx] |= (del(.icon, .iconScale) | .glyph = $(jq -Rn --arg g "$art" '$g'))" ;;
    "Icon from your icon theme")
      art=$(gum input --header "Icon name or absolute path" --placeholder "utilities-terminal")
      [[ -z $art ]] && return 1
      apply ".items[$idx] |= (del(.glyph) | .icon = $(jq -Rn --arg a "$art" '$a'))" ;;
    "Use the app's own icon")
      apply ".items[$idx] |= del(.glyph, .icon)" ;;
    *) return 1 ;;
  esac
}

change_artwork() {
  [[ $(item_count) == "0" ]] && { notice "No items yet."; return; }
  local pos
  pos=$(item_choices | gum choose --header "Which item?" --label-delimiter=$'\t')
  [[ -z $pos ]] && return
  set_item_artwork "$((pos - 1))" && notice "Updated \"$(item_label "$((pos - 1))")\"."
}

# Walk every non-divider item and offer a glyph for each. Escape skips one;
# useful right after adding apps, or when switching a whole dock over.
assign_glyphs_all() {
  local count i
  count=$(item_count)
  for ((i = 0; i < count; i++)); do
    [[ $(dock_field ".items[$i].spacer // false") == "true" ]] && continue
    local art
    art=$(pick_glyph "Glyph for \"$(item_label "$i")\"  ($((i + 1))/$count, esc to skip)") || continue
    [[ -z $art ]] && continue
    apply ".items[$i] |= (del(.icon, .iconScale) | .glyph = $(jq -Rn --arg g "$art" '$g'))"
  done
}

# ------------------------------------------------------------------ actions

add_apps() {
  local picked
  picked=$(list_apps | gum filter --no-limit \
    --placeholder "Type to search your installed apps" \
    --header "Select apps to add (tab to multi-select, enter to confirm)")
  [[ -z $picked ]] && return

  local added=0 id first
  first=$(item_count)
  while IFS=$'\t' read -r _ id; do
    [[ -z $id ]] && continue
    apply ".items += [{\"desktop\": \"$id\"}]" && ((added++))
  done <<<"$picked"

  [[ $added -gt 0 ]] || return
  notice "Added $added item(s)."

  # A glyph dock wants glyphs on newcomers too; offer them straight away
  # rather than leaving one full-colour icon in a row of monochrome ones.
  gum confirm "Give the new item(s) a glyph now?" || return
  local i count
  count=$(item_count)
  for ((i = first; i < count; i++)); do
    local art
    art=$(pick_glyph "Glyph for \"$(item_label "$i")\"  (esc to skip)") || continue
    [[ -z $art ]] && continue
    apply ".items[$i].glyph = $(jq -Rn --arg g "$art" '$g')"
  done
}

add_command() {
  local label cmd kind art json
  label=$(gum input --header "Label" --placeholder "Deploy")
  [[ -z $label ]] && return
  cmd=$(gum input --header "Command (runs through bash)" --placeholder "~/bin/deploy.sh")
  [[ -z $cmd ]] && return

  kind=$(gum choose "Glyph from the list" "Paste a glyph" "Icon from your icon theme" "No icon" \
    --header "How should it look?")

  case $kind in
    "Glyph from the list")
      art=$(pick_glyph "Glyph for \"$label\"") || art=""
      json=$(jq -nc --arg l "$label" --arg c "$cmd" --arg a "$art" \
        'if $a == "" then {exec:$c, label:$l} else {exec:$c, glyph:$a, label:$l} end') ;;
    "Paste a glyph")
      art=$(gum input --header "Paste a glyph (nerdfonts.com/cheat-sheet)" --placeholder "󰆍")
      json=$(jq -nc --arg l "$label" --arg c "$cmd" --arg a "$art" \
        'if $a == "" then {exec:$c, label:$l} else {exec:$c, glyph:$a, label:$l} end') ;;
    "Icon from your icon theme")
      art=$(gum input --header "Icon name or absolute path" --placeholder "utilities-terminal")
      json=$(jq -nc --arg l "$label" --arg c "$cmd" --arg a "$art" \
        'if $a == "" then {exec:$c, label:$l} else {exec:$c, icon:$a, label:$l} end') ;;
    *)
      json=$(jq -nc --arg l "$label" --arg c "$cmd" '{exec:$c, label:$l}') ;;
  esac

  apply ".items += [$json]" && notice "Added \"$label\"."
}

add_divider() {
  apply '.items += [{"spacer": true}]' && notice "Added a divider."
}

remove_items() {
  [[ $(item_count) == "0" ]] && { notice "Nothing to remove."; return; }

  local picked
  picked=$(item_choices | gum choose --no-limit \
    --header "Select items to remove (tab to multi-select)" \
    --label-delimiter=$'\t')
  [[ -z $picked ]] && return

  # Delete from the highest index down so earlier removals don't shift the
  # positions of the ones still queued.
  local indices
  indices=$(sort -rn <<<"$picked")

  local n removed=0
  while read -r n; do
    [[ -z $n ]] && continue
    apply ".items |= (del(.[$((n - 1))]))" && ((removed++))
  done <<<"$indices"

  [[ $removed -gt 0 ]] && notice "Removed $removed item(s)."
}

# Move one item at a time, redrawing the order after each nudge so you can
# see where it landed before deciding the next move.
reorder() {
  local count
  count=$(item_count)
  [[ $count == "0" || $count == "1" ]] && { notice "Not enough items to reorder."; return; }

  local pos label
  pos=$(item_choices | gum choose --header "Which item do you want to move?" --label-delimiter=$'\t')
  [[ -z $pos ]] && return
  label=$(item_label "$((pos - 1))")

  while true; do
    clear
    show_items
    heading "Moving: $label  (now at position $pos of $(item_count))"
    echo

    local action
    action=$(gum choose "Up" "Down" "To start" "To end" "Done" --header "Move it where?")
    [[ -z $action || $action == "Done" ]] && return

    local from=$((pos - 1)) to
    case $action in
      "Up")       to=$((from - 1)) ;;
      "Down")     to=$((from + 1)) ;;
      "To start") to=0 ;;
      "To end")   to=$(($(item_count) - 1)) ;;
    esac

    if ((to < 0)) || ((to >= $(item_count))); then
      notice "Already at the end of the dock."
      sleep 0.6
      continue
    fi

    # Pull the element out, then splice it back in at the target index. The
    # null guard matters: jq happily indexes past the end of an array and
    # would splice a null into the dock rather than fail.
    apply ".items |= (. as \$l | (\$l[$from]) as \$m |
      if \$m == null then \$l else
        (\$l[0:$from] + \$l[$from+1:]) as \$rest |
        \$rest[0:$to] + [\$m] + \$rest[$to:]
      end)" || return
    pos=$((to + 1))
  done
}

# ---------------------------------------------------------------- appearance

set_number() {
  local key=$1 prompt=$2 fallback=$3 current value
  current=$(dock_field ".$key // $fallback")
  value=$(gum input --header "$prompt" --value "$current")
  [[ -z $value ]] && return
  if ! [[ $value =~ ^[0-9]+$ ]]; then
    gum style --foreground 1 "Needs to be a whole number."
    sleep 1
    return
  fi
  apply ".$key = $value"
}

# Rounded tiles inside a square card look like a mistake. The rule for nested
# corners is outer = inner + padding, which the dock computes for itself and
# reports as concentricRadius — so offer that rather than make it a guess.
set_corner_radius() {
  local concentric current choice
  concentric=$(omarchy-shell rdf.dock state 2>/dev/null | jq -r '.concentricRadius // empty')
  current=$(dock_field '.cornerRadius // "follows Hyprland"')

  choice=$(gum choose \
    "Match the tiles (${concentric:-?}px)" \
    "Follow Hyprland's window rounding" \
    "Enter a value" \
    --header "Dock corner rounding  (currently: $current)")

  case $choice in
    "Match the tiles"*)  [[ -n $concentric ]] && apply ".cornerRadius = $concentric" ;;
    "Follow Hyprland"*)  apply 'del(.cornerRadius)' ;;
    "Enter a value")     set_number cornerRadius "Corner radius in pixels" "${concentric:-12}" ;;
    *) return ;;
  esac
}

set_flag() {
  local key=$1 prompt=$2 current choice
  current=$(dock_field ".$key")
  choice=$(gum choose "On" "Off" --header "$prompt  (currently: ${current:-unset})")
  [[ -z $choice ]] && return
  [[ $choice == "On" ]] && apply ".$key = true" || apply ".$key = false"
}

# Tiles are painted one of two ways. "button" borrows the shell's [controls]
# tokens — the same fill and 1px border every Quickshell button has, with a
# hover state — so the dock reads as part of the kit. "flat" is a plain wash
# of the text colour at `tileOpacity`. Because the dock treats a present
# `tileOpacity` as a request for flat, choosing button has to drop it.
set_tile_style() {
  local current choice
  current=$(dock_field 'if .tileStyle == "flat" or .tileOpacity != null then "flat" else "button" end')
  choice=$(gum choose \
    "Button — shell control fill and border, lights up on hover" \
    "Flat — a plain wash at the tile opacity" \
    --header "Tile style  (currently: $current)")
  case $choice in
    Button*) apply 'del(.tileOpacity, .tileStyle)' ;;
    Flat*)   apply '.tileStyle = "flat"' ;;
    *) return ;;
  esac
}

# Left unset, tiles follow the shell's corner radius exactly like every
# button does — square in a square theme, rounded in a rounded one.
set_tile_radius() {
  local current choice
  current=$(dock_field '.tileRadius // "follows theme"')
  choice=$(gum choose \
    "Follow the theme (same rounding as shell buttons)" \
    "Enter a value" \
    --header "Tile roundness  (currently: $current)")
  case $choice in
    Follow*)         apply 'del(.tileRadius)' ;;
    "Enter a value") set_number tileRadius "Corner rounding as a % of the tile, 0-50 (23 is squircle-ish)" 23 ;;
    *) return ;;
  esac
}

set_glyph_color() {
  local current choice
  current=$(dock_field '.glyphColor // "text"')
  choice=$(gum choose \
    "Text — the popup text colour, accent on hover" \
    "Accent — always the theme accent" \
    --header "Glyph colour  (currently: $current)")
  case $choice in
    Text*)   apply 'del(.glyphColor)' ;;
    Accent*) apply '.glyphColor = "accent"' ;;
    *) return ;;
  esac
}

appearance() {
  while true; do
    clear
    heading "Appearance"
    printf '  icon size   %s\n' "$(dock_field '.iconSize // 40')"
    printf '  spacing     %s\n' "$(dock_field '.spacing // 6')"
    printf '  padding     %s\n' "$(dock_field '.padding // 8')"
    printf '  magnify     %s\n' "$(dock_field '.magnify // true')"
    printf '  labels      %s\n' "$(dock_field '.labels // true')"
    printf '  tiles       %s (%s, roundness %s)\n' "$(dock_field '.tiles // false')" \
      "$(dock_field 'if .tileStyle == "flat" or .tileOpacity != null then "flat, opacity \(.tileOpacity // 16)" else "button" end')" \
      "$(dock_field '.tileRadius // "theme"')"
    printf '  glyphs      colour %s, size %s\n' "$(dock_field '.glyphColor // "text"')" "$(dock_field '.glyphScale // 58')"
    printf '  dock bg     %s\n' "$(dock_field '.backgroundOpacity // 100')"
    printf '  icon alpha  %s\n' "$(dock_field '.iconOpacity // 100')"
    printf '  border      %s\n' "$(dock_field '.border // true')"
    printf '  corners     %s\n' "$(dock_field '.cornerRadius // "theme"')"
    printf '  edge gap    %s\n' "$(dock_field '.edgeGap // "theme default"')"
    printf '  when empty  %s\n' "$(dock_field '.showWhenEmpty // false')"
    echo

    local choice
    choice=$(gum choose \
      "Icon size" "Spacing between icons" "Padding around icons" \
      "Icon tiles" "Tile style" "Tile opacity" "Tile roundness" "Icon size inside tile" \
      "Glyph colour" "Glyph size" \
      "Dock corner roundness" \
      "Dock background opacity" "Icon opacity" \
      "Border" "Gap from screen edge" "Stay up on an empty workspace" \
      "Even out icon sizes" "Clear icon size adjustments" \
      "Magnify on hover" "Show labels" \
      "Reveal delay" "Hide delay" "Hotspot spans full width" \
      "Back" --header "What do you want to change?")

    case $choice in
      "Icon size")                set_number iconSize "Icon size in pixels" 40 ;;
      "Spacing between icons")    set_number spacing "Gap between icons in pixels" 6 ;;
      "Padding around icons")     set_number padding "Padding inside the dock in pixels" 8 ;;
      "Icon tiles")               set_flag tiles "Put each icon in its own container" ;;
      "Tile style")               set_tile_style ;;
      "Dock corner roundness")    set_corner_radius ;;
      "Tile opacity")             set_number tileOpacity "Tile opacity, 0-100 (flat style only — setting this switches to flat)" 16 ;;
      "Tile roundness")           set_tile_radius ;;
      "Icon size inside tile")    set_number tileInset "How much of the tile the icon fills, 0-100" 76 ;;
      "Glyph colour")             set_glyph_color ;;
      "Glyph size")               set_number glyphScale "Glyph height as a % of the slot, 30-90" 58 ;;
      "Dock background opacity")  set_number backgroundOpacity "Dock background opacity, 0-100" 100 ;;
      "Icon opacity")             set_number iconOpacity "Icon opacity, 0-100" 100 ;;
      "Border")                   set_flag border "Draw a border around the dock" ;;
      "Gap from screen edge")     set_number edgeGap "Gap from the screen edge in pixels (0 sits flush)" 5 ;;
      "Stay up on an empty workspace") set_flag showWhenEmpty "Keep the dock visible when the workspace has no windows" ;;
      "Even out icon sizes")      normalize_icons ;;
      "Clear icon size adjustments") reset_icon_scales ;;
      "Magnify on hover")         set_flag magnify "Magnify icons on hover" ;;
      "Show labels")              set_flag labels "Show a label above the hovered icon" ;;
      "Reveal delay")             set_number revealDelay "Delay before the dock appears (ms)" 90 ;;
      "Hide delay")               set_number hideDelay "Delay before the dock hides (ms)" 350 ;;
      "Hotspot spans full width") set_flag hotspotFullWidth "Reveal from anywhere along the bottom edge" ;;
      *) return ;;
    esac
  done
}

# ------------------------------------------------------- optical sizing
#
# Icons all render into the same box, but they don't fill it the same way:
# some carry heavy transparent padding, and a square logo reads much bigger
# than a circle at identical box size. Measuring painted *area* captures both
# at once — a circle covers ~79% of its bounding box, a square 100% — so
# equalising area equalises how large each icon looks.
#
# scale = sqrt(target / coverage), because area grows with the square of the
# scale. Clamped so the sparsest icon grows by at most 15%, which keeps every
# icon inside its slot and the spacing even.

ICON_AREA_TARGET=0.55

# Resolve the file the dock will actually draw. AppLibrary's index emits SVGs
# ahead of PNGs and keeps the first hit per name, so scalable wins there and
# has to win here too — measuring a PNG variant of an icon that renders as an
# SVG gives a scale correction for the wrong artwork.
icon_file_for_name() {
  local name=$1
  [[ $name == /* ]] && { [[ -f $name ]] && printf '%s' "$name"; return; }

  local svg
  svg=$(find ~/.local/share/icons ~/.icons /usr/share/icons /usr/share/pixmaps \
    -name "$name.svg" 2>/dev/null | head -1)
  [[ -n $svg ]] && { printf '%s' "$svg"; return; }

  # Otherwise the largest raster: more pixels, more accurate coverage.
  find ~/.local/share/icons ~/.icons /usr/share/icons /usr/share/pixmaps \
    -name "$name.png" 2>/dev/null |
    awk '{ n = $0; sub(/.*\/([0-9]+)x[0-9]+\/.*/, "\\1", n); if (n !~ /^[0-9]+$/) n = 0; print n "\t" $0 }' |
    sort -rn | head -1 | cut -f2
}

# SVGs must be rasterised at a fixed size before their alpha means anything.
icon_coverage() {
  local file=$1
  if [[ $file == *.svg ]]; then
    magick -background none -density 256 "$file" -resize 256x256 \
      -alpha extract -format "%[fx:mean]" info: 2>/dev/null
  else
    magick "$file" -alpha extract -format "%[fx:mean]" info: 2>/dev/null
  fi
}

icon_name_for_item() {
  local idx=$1 name did
  name=$(dock_field ".items[$idx].icon // empty")
  [[ -n $name ]] && { printf '%s' "$name"; return; }
  did=$(dock_field ".items[$idx].desktop // empty")
  [[ -z $did ]] && return
  local f
  for f in "$HOME/.local/share/applications/$did.desktop" "/usr/share/applications/$did.desktop"; do
    [[ -f $f ]] || continue
    grep -m1 '^Icon=' "$f" | cut -d= -f2-
    return
  done
}

normalize_icons() {
  require magick

  local count changed=0 i
  count=$(item_count)
  heading "Measuring painted area for $count item(s)..."
  echo

  for ((i = 0; i < count; i++)); do
    local label; label=$(item_label "$i")

    if [[ $(dock_field ".items[$i].spacer // false") == "true" ]]; then continue; fi
    if [[ -n $(dock_field ".items[$i].glyph // empty") ]]; then
      printf '  %-28s glyph — sized automatically\n' "$label"
      continue
    fi

    local name file
    name=$(icon_name_for_item "$i")
    [[ -z $name ]] && { printf '  %-28s no icon\n' "$label"; continue; }
    file=$(icon_file_for_name "$name")
    [[ -z $file ]] && { printf '  %-28s icon %s not on disk\n' "$label" "$name"; continue; }

    local cov scale
    cov=$(icon_coverage "$file")
    [[ -z $cov ]] && continue
    scale=$(python3 -c "
import sys
cov = float('$cov')
if cov <= 0: sys.exit(1)
s = ($ICON_AREA_TARGET / cov) ** 0.5
print(f'{min(1.15, max(0.70, s)):.3f}')" 2>/dev/null) || continue

    printf '  %-28s coverage %.3f -> scale %s\n' "$label" "$cov" "$scale"
    apply ".items[$i].iconScale = $scale" && ((changed++))
  done

  echo
  notice "Adjusted $changed icon(s)."
  gum input --header "Press enter to continue" --placeholder "" >/dev/null
}

reset_icon_scales() {
  local count i
  count=$(item_count)
  for ((i = 0; i < count; i++)); do apply "if .items[$i].iconScale then .items[$i] |= del(.iconScale) else . end" >/dev/null; done
  notice "Cleared all icon size adjustments."
}

# An item with a `when` command holds a slot only while that command exits 0.
set_condition() {
  [[ $(item_count) == "0" ]] && { notice "No items yet."; return; }

  local pos label current cmd
  pos=$(item_choices | gum choose --header "Which item?" --label-delimiter=$'\t')
  [[ -z $pos ]] && return
  label=$(item_label "$((pos - 1))")
  current=$(dock_field ".items[$((pos - 1))].when // empty")

  cmd=$(gum input \
    --header "Show \"$label\" only when this command succeeds (blank = always)" \
    --placeholder "pgrep xfreerdp" \
    --value "$current")

  # gum returns empty both for a cleared field and for a cancelled prompt;
  # confirm before dropping an existing condition so escape isn't destructive.
  if [[ -z $cmd ]]; then
    [[ -z $current ]] && return
    gum confirm "Remove the condition from \"$label\"?" || return
    apply ".items[$((pos - 1))] |= del(.when)" && notice "Condition removed."
    return
  fi

  apply ".items[$((pos - 1))].when = $(jq -Rn --arg c "$cmd" '$c')" \
    && notice "\"$label\" now shows only when: $cmd"
}

preview() {
  omarchy-shell rdf.dock show >/dev/null 2>&1
  notice "Showing the dock for 3 seconds..."
  sleep 3
  omarchy-shell rdf.dock hide >/dev/null 2>&1
}

# ---------------------------------------------------------------------- main

require gum
require jq
[[ -f $CFG ]] || die "No shell.json at $CFG"

# Create the plugin entry if it isn't registered yet, so this works on a
# fresh setup and not only on one where the dock is already configured.
if ! jq -e "$DOCK | .id" "$CFG" >/dev/null 2>&1; then
  tmp=$(mktemp "$CFG.XXXXXX")
  if jq '.plugins = ((.plugins // []) + [{"id":"rdf.dock","items":[]}])' "$CFG" >"$tmp" 2>/dev/null; then
    cp "$CFG" "$CFG.bak"
    mv "$tmp" "$CFG"
  else
    rm -f "$tmp"
    die "Could not register the dock plugin in shell.json"
  fi
fi

while true; do
  clear
  gum style --border rounded --padding "0 1" --margin "0 0 1 0" "Omarchy Dock"
  show_items

  choice=$(gum choose \
    "Add apps" "Add a command" "Add a divider" \
    "Change icon / glyph" "Give every item a glyph" \
    "Remove items" "Reorder" "Visibility condition" "Appearance" \
    "Preview" "Quit" --header "What next?")

  case $choice in
    "Add apps")      add_apps ;;
    "Add a command") add_command ;;
    "Add a divider") add_divider ;;
    "Change icon / glyph")     change_artwork ;;
    "Give every item a glyph") assign_glyphs_all ;;
    "Remove items")  remove_items ;;
    "Reorder")       reorder ;;
    "Visibility condition") set_condition ;;
    "Appearance")    appearance ;;
    "Preview")       preview ;;
    *) clear; exit 0 ;;
  esac
done
